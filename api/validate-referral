const { initFirebase, methodGuard } = require("../firebase-helper");

module.exports = async function handler(req, res) {
  if (methodGuard(req, res)) return;

  try {
    const referralId = String(
      req.body?.referralId ||
      req.body?.referralCode ||
      req.body?.referral ||
      req.query?.referralId ||
      ""
    )
      .trim()
      .toUpperCase();

    if (!referralId) {
      return res.status(400).json({
        success: false,
        valid: false,
        message: "Referral ID is required."
      });
    }

    const admin = initFirebase();
    const db = admin.firestore();

    // Referral IDs are stored in the userID field.
    const snapshot = await db
      .collection("users")
      .where("userID", "==", referralId)
      .limit(1)
      .get();

    if (snapshot.empty) {
      return res.status(200).json({
        success: true,
        valid: false,
        message: "Referral ID was not found."
      });
    }

    return res.status(200).json({
      success: true,
      valid: true,
      message: "Referral ID is valid."
    });

  } catch (error) {
    console.error("validate-referral error:", error);

    return res.status(500).json({
      success: false,
      valid: false,
      message: "Server error while validating referral ID."
    });
  }
};
